{
  "name": "cosmic-ai",
  "version": "1.2.0",
  "description": "Cosmic AI local agent with Telegram control and computer-use automation",
  "main": "electron/main.cjs",
  "type": "module",
  "bin": {
    "cosmic": "./cosmic.js",
    "computer-agent": "./app.js"
  },
  "build": {
    "appId": "com.teeyansh.ai-computer-agent",
    "productName": "AI Computer Agent",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "dir"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "We need access to your microphone to hear your commands.",
        "NSCameraUsageDescription": "We need access to your camera.",
        "NSScreenCaptureUsageDescription": "We need screen recording access to see your apps.",
        "NSAccessibilityUsageDescription": "We need accessibility to control the mouse and keyboard."
      }
    }
  },
  "scripts": {
    "start": "electron .",
    "cli": "node run.js",
    "setup": "node setup.js",
    "cosmic": "node cosmic.js",
    "demo": "node demo.js",
    "crowd:demo": "node crowd-sim/inference.js",
    "build": "electron-builder",
    "pkg:mac:arm64": "pkg cosmic.js --targets node18-macos-arm64 --output build/cosmic-darwin-arm64",
    "pkg:mac:x64": "pkg cosmic.js --targets node18-macos-x64 --output build/cosmic-darwin-x64",
    "pkg:mac": "npm run pkg:mac:arm64 && npm run pkg:mac:x64",
    "pkg:linux": "pkg cosmic.js --targets node18-linux-x64 --output build/cosmic-linux-x64",
    "pkg:all": "npm run pkg:mac && npm run pkg:linux"
  },
  "keywords": [
    "ai",
    "automation",
    "computer-use",
    "gemini",
    "agent",
    "rpa",
    "screen-automation"
  ],
  "author": "Cosmic AI",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "dotenv": "^17.2.3",
    "keyboardjs": "^2.7.0",
    "node-telegram-bot-api": "^0.67.0",
    "screenshot-desktop": "^1.15.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TeeyanshShukla/Cosmic.git"
  },
  "homepage": "https://github.com/TeeyanshShukla/Cosmic#readme",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0",
    "electron-rebuild": "^3.2.9",
    "pkg": "^5.8.1"
  }
}
