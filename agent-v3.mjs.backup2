// 🚔 SPOTLIGHT VALIDATOR - Enforces Spotlight → Space → Type Law
const SPOTLIGHT_VALIDATOR_PROMPT = `You are a Spotlight Sequence Validator. Your ONLY job is to enforce THE LAW:

🚨 THE LAW: Spotlight opened → NEXT action MUST be Space → THEN Type

INPUT: 
- Previous action (e.g., just opened Spotlight with LeftCmd+Space)
- Proposed next action (what AI wants to do now)

YOUR JOB:
1. If previous action = Spotlight opening (LeftCmd+Space):
   - Check if proposed action = Space press
   - If YES → Return {"status": "APPROVED"}
   - If NO (e.g., trying to Type) → Return {"status": "REJECTED", "reason": "SPOTLIGHT LAW BROKEN! You opened Spotlight but did NOT press Space. You must press Space BEFORE typing. Sequence: Spotlight → Space → Type"}

2. If previous action = Space was pressed:
   - Check if proposed action = Type
   - If YES → Return {"status": "APPROVED"}
   - If NO → Return {"status": "REJECTED", "reason": "After pressing Space, you must Type next. Do not skip to other actions."}

3. Otherwise → Return {"status": "APPROVED"}

RESPOND ONLY WITH JSON. NEVER SKIP THIS CHECK FOR SPOTLIGHT.
`;

// 🕵️ VERIFIER FUNCTION
async function verifyAction(userGoal, screenshot, proposedAction) {
    try {
        const response = await retryWithBackoff(async () => {
            return await ai.models.generateContent({
                model: CONFIG.MODEL_NAME,
                systemInstruction: VERIFIER_PROMPT,
                contents: [
                    {
                        role: "user",
                        parts: [
                            {
                                inlineData: {
                                    mimeType: "image/png",
                                    data: screenshot
                                }
                            },
                            {
                                text: `USER GOAL: ${userGoal}                            
PROPOSED ACTION: ${JSON.stringify(proposedAction)}

Verify this action. Return JSON.`
                            }
                        ]
                    }
                ]
            });
        });

        const text = response.candidates[0].content.parts[0].text;
        console.log("🕵️ Verifier says:", text);
        let result = extractJSON(text);

        // [NEW] SMART NORMALIZATION
        // Fixes: Model returning {"answer": "no"} instead of {"status": "REJECTED"}
        if (result) {
            // 1. Map alternative keys to 'status'
            if (!result.status) {
                if (result.answer) result.status = result.answer;
                if (result.decision) result.status = result.decision;
                if (result.verdict) result.status = result.verdict;
                if (result.evaluation) result.status = result.evaluation;
            }

            // 2. Map negative values to "REJECTED"
            if (result.status) {
                const s = String(result.status).toLowerCase();
                if (s.includes("no") || s.includes("reject") || s.includes("false") || s.includes("bad") || s.includes("incorrect")) {
                    result.status = "REJECTED";
                } else if (s.includes("yes") || s.includes("approve") || s.includes("true") || s.includes("good") || s.includes("correct") || s.includes("pass") || s.includes("accept")) {
                    result.status = "APPROVED";
                }
            } else {
                // 3. Last Resort: Scan 'explanation' or 'reason' for negative words
                const reason = (result.reason || result.explanation || "").toLowerCase();
                if (reason.includes("wrong") || reason.includes("incorrect") || reason.includes("reject")) {
                    result.status = "REJECTED";
                }
            }
        }

        return result;

    } catch (error) {
        console.error("⚠️ Verification system unavailable:", error.message);
        console.error("   Proceeding with caution. Actual user action may differ from expectations.");
        return { status: "APPROVED", reason: "Verifier unavailable, failing open." };
    }
}

// 🧠 PLANNER - Analyzes screenshot and returns action plan
async function planNextAction(userGoal, screenshot, context = "", screenSize = { width: 1920, height: 1080 }) {
    try {
        // [NEW] ⚡️ HARD LOOP DETECTION (Force Tab Fallback)
        // User Logic: If we are interacting with the same screen area repeatedly, FORCE TAB.
        // Fixes: "Move -> Click -> Move -> Click" loops where 'consecutiveMoves' fails.
        if (actionHistory.length >= 3) {
            let recentActions = actionHistory.slice(-5); // Look at last 5
            let sameSpotCount = 0;

            // Get the last known coordinates
            let lastCoords = null;
            for (let i = recentActions.length - 1; i >= 0; i--) {
                if (recentActions[i].args && recentActions[i].args.x !== undefined) {
                    lastCoords = recentActions[i].args;
                    break;
                }
            }

            // Count how many recent actions were near this spot
            if (lastCoords) {
                for (let act of recentActions) {
                    if (act.args && act.args.x !== undefined) {
                        const distanceInPixels = Math.sqrt(Math.pow(act.args.x - lastCoords.x, 2) + Math.pow(act.args.y - lastCoords.y, 2));
                        if (distanceInPixels < CONFIG.LOOP_DETECTION_RADIUS_PX) sameSpotCount++;
                    }
                }
            }

            // [USER REQUEST]: REMOVED HARD TAB FALLBACK
            // The user wants natural intelligence (shortcuts first), not hard triggers.
            /*
            if (sameSpotCount >= 3) {
                console.log(`🔄 HARD LOOP DETECTED (${sameSpotCount} actions in same spot). Forcing TAB fallback.`);
                return { action: "key", args: { key: "tab" } };
            }
            */
        }

        // [NEW] 🧠 Retrieve relevant memories (CONTEXTUAL LEARNING)
        let memoryContext = "";
        try {
            // Search for relevant past interactions
            const relevantMemories = await memory.search(userGoal, 5); // Increased limit
            if (relevantMemories.length > 0) {
                memoryContext = `
🧠 LEARNED COORDINATES & PAST MISTAKES (MEM0):
${relevantMemories.map(m => `   - ${m.text}`).join('\n')}
   - USE THIS HISTORY: If a coordinate failed before (RESULT: REJECTED), DO NOT USE IT AGAIN.
   - If a coordinate worked (RESULT: SUCCESS), USE IT.
`;
                console.log("🧠 Injected Contextual Memories:", relevantMemories.map(m => m.text));
            }
        } catch (memErr) {
            console.error("⚠️ Memory retrieval failed:", memErr.message);
        }

        // [MODIFIED] Append protocol violation context if encountered
        let enhancedContext = context + memoryContext;
        if (actionHistory.some(a => a.violation)) {
            enhancedContext += "\n\nCRITICAL WARNING: You previously violated the MOVE -> WAIT -> CLICK protocol. You MUST wait after moving before clicking.";
        }
        if (actionHistory.some(a => a.loop)) {
            enhancedContext += "\n\nCRITICAL WARNING: You are LOOPING (clicking same spot). STOP. Use SCROLL or Move to a different location.";
        }

        // [NEW] FORCE CLICK AFTER MOVE
        // Check if the IMMEDIATE last action was 'move'
        if (actionHistory.length > 0 && actionHistory[actionHistory.length - 1].action === 'move') {
            enhancedContext += `

📢 ACTION CONTEXT: You just moved the mouse.
            👉 IF the cursor is correctly positioned over the target (Verify visually):
            👉 YOUR NEXT STEP MUST BE: {"action": "click", "args": {}}
            👉 DO NOT MOVE AGAIN unless you are wildly off-target.`;
        }

        const response = await retryWithBackoff(async () => {
            return await ai.models.generateContent({
                model: CONFIG.MODEL_NAME,
                systemInstruction: PLANNER_PROMPT,
                contents: [
                    {
                        role: "user",
                        parts: [
                            {
                                text: "Example: Open Spotlight search"
                            }
                        ]
                    },
                    {
                        role: "model",
                        parts: [
                            {
                                text: '{"action": "key_combo", "args": {"keys": "LeftCmd+Space"}}'
                            }
                        ]
                    },
                    {
                        role: "user",
                        parts: [
                            {
                                text: "Example: Analyze screenshot and position mouse in Spotlight search box"
                            }
                        ]
                    },
                    {
                        role: "model",
                        parts: [
                            {
                                text: 'I see the Spotlight search bar in the center-top. Coordinates approx (650, 335). Moving there.\n{"action": "move", "args": {"x": 650, "y": 335}}'
                            }
                        ]
                    },
                    {
                        role: "user",
                        parts: [
                            {
                                text: "Example: Open app in Chrome if not found"
                            }
                        ]
                    },
                    {
                        role: "model",
                        parts: [
                            {
                                text: 'Calculator failed to open. Will try Chrome.\n{"action": "key_combo", "args": {"keys": "cmd+b"}}'
                            }
                        ]
                    },
                    {
                        role: "user",
                        parts: [
                            {
                                inlineData: {
                                    mimeType: "image/png",
                                    data: screenshot
                                }
                            },
                            {
                                text: `IGNORE any terminal windows or command prompts in the screenshot. Focus ONLY on the desktop and applications.

GOAL: ${userGoal}
SCREEN RESOLUTION: ${screenSize.width}x${screenSize.height}
ESTIMATED SCREEN CENTER: X=${Math.floor(screenSize.width / 2)}, Y=${Math.floor(screenSize.height / 2)}

CONTEXT FROM PREVIOUS ATTEMPTS:
${context}

   - Press LeftCmd+Space key combination to open Spotlight search
   - IMMEDIATELY after opening Spotlight, the focus is ALREADY in the search box.
   - DO NOT CLICK. Clicking is unnecessary and error-prone.
   - Action: "type" immediately with the search term.
   - VERIFICATION: After typing, look at the screenshot to see if the text appears in the search box.
   - IF valid text appears: Press "enter".
   - IF text did NOT appear: Then and only then try to click.

3. COORDINATE VARIATION PROTOCOL:
   - Only relevant if "move" is actually needed.

4. HONESTY VERIFICATION PROTOCOL:
   - Verify if typed text is visible.

5. CONTEXT AWARENESS:
   - If "type" failed to produce text, then switch strategy to "move" + "click".
13. NEVER move to the next step unless you can verify the current step worked with visual confirmation

FINAL REMINDER:
- "click" action MUST have empty args: "args": {}
- TO CLICK NOW: {"action": "click", "args": {}}

Determine the NEXT SINGLE ACTION needed to achieve this goal. Follow the mandatory verification protocols.`
                            }
                        ]
                    }
                ]
            });
        });

        const text = response.candidates[0].content.parts[0].text;
        console.log("🧠 Planner says:", text);

        // Extract JSON with multiple strategies
        let actionPlan = extractJSON(text);

        // [DISABLED] 🕵️ VERIFICATION DISABLED AS PER USER REQUEST
        // if (actionPlan) {
        //     console.log("🕵️ Verifying plan:", actionPlan);
        //     const verification = await verifyAction(userGoal, screenshot, actionPlan);
        //
        //     if (verification && verification.status === "REJECTED") {
        //         console.log(`❌ VERIFIER REJECTED: ${verification.reason}`);
        //         // ... functionality disabled ...
        //     }
        // }

        if (!actionPlan) {
            console.log("❌ No valid JSON found, using wait");
            actionPlan = { action: "wait", args: { ms: 1000 } };
        }

        console.log("🎯 Action plan:", actionPlan);
        return actionPlan;

    } catch (error) {
        console.error("❌ Planner error:", error.message);
        return { action: "wait", args: { ms: 1000 } };
    }
}

// 🎹 Helper: Check if key combination is a Spotlight trigger
function isSpotlightTrigger(keyCombination) {
    const triggers = ['cmd+space', 'command+space', 'leftcmd+space', 'rightcmd+space'];
    const lowerKeys = (keyCombination || "").toLowerCase();
    return triggers.some(trigger => lowerKeys.includes(trigger));
}

// 🎹 Helper: Handle Spotlight opening sequence
async function handleSpotlightOpening() {
    global.spotlightJustOpened = true;
    console.log("✨ SPOTLIGHT OPENED - Flag set for AI to consider space.");
    await tools.wait({ ms: CONFIG.SPOTLIGHT_DELAY_MS });
}

// 🦾 DIRECT EXECUTOR - Maps action plan directly to tool calls
async function executeActionDirect(actionPlan) {
    if (global.spotlightJustOpened) {
        console.log("🎯 Spotlight just opened. Forcing backspace and then space.");
        await tools.key({ key: "backspace" }); // Hardcoded backspace (delete on Mac)
        await tools.key({ key: "space" });    // Hardcoded space
        global.spotlightJustOpened = false;
        // This ensures the planner's *intended* next action (e.g., type) still happens.
        // The forced backspace and space will occur *before* the planner's next action.
    }
    try {
        // Track for Spotlight validator (do this FIRST)
        global.lastAction = actionPlan;

        let { action, args } = actionPlan;

        // 🚔 SPOTLIGHT VALIDATOR CHECK
        if (global.lastAction) {
            const spotlightValidation = await spotlightValidator(global.lastAction, actionPlan, actionHistory);
            if (spotlightValidation.status === "REJECTED") {
                console.log("🚨 SPOTLIGHT LAW VIOLATION DETECTED!");
                console.log("📢 VALIDATOR FEEDBACK:", spotlightValidation.reason);
                console.log("🔄 Rejecting this action and telling Planner to fix it.");
                actionHistory.push({
                    action: actionPlan.action,
                    args: actionPlan.args,
                    result: "REJECTED - " + spotlightValidation.reason
                });
                return {
                    success: false,
                    message: `🚨 SPOTLIGHT LAW BROKEN! ${spotlightValidation.reason}\nPlanner must output Space action before Type.`,
                    rejected: true
                };
            }
        }

        // 🛡️ JITTER GUARD (Micro-Move Auto-Correction) 🛡️
        // User Request: "u fixed nothing" -> Agent is stuck in a loop of tiny mouse adjustments.
        // Fix: If Agent moves < JITTER_THRESHOLD_PX pixels immediately after another move, assume it wants to click.
        if (action === 'move' && lastActionType === 'move' && lastActionArgs && lastActionArgs.x !== undefined && lastActionArgs.y !== undefined) {
            const movementDistance = Math.sqrt(Math.pow(args.x - lastActionArgs.x, 2) + Math.pow(args.y - lastActionArgs.y, 2));
            if (movementDistance < CONFIG.JITTER_THRESHOLD_PX) {
                console.log(`✨ JITTER GUARD: Micro-move detected (${movementDistance.toFixed(1)}px). Converting to CLICK.`);

                // 1. Execute the lingering move first (to be precise)
                await tools.move({ x: args.x, y: args.y });

                // 2. FORCE CLICK
                console.log("🦾 Auto-Clicking target...");
                await tools.click();
                await tools.take_screenshot();

                // 3. Update History & Return Trigger
                actionHistory.push({ action: 'move', args: args, result: 'jitter_corrected_to_click' });
                actionHistory.push({ action: 'click', args: {}, result: 'auto_clicked' });

                return {
                    success: true,
                    message: `✅ JITTER FIX: You moved very slightly (${dist.toFixed(1)}px). I assumed you meant to CLICK, so I clicked for you.\nNext, proceed to the verification step.`
                };
            }
        }

        // 🛡️ STRICT CLICK SYNTAX ENFORCEMENT 🛡️

        // CASE 1: INVALID USAGE -> `click(x,y)`
        // The tool definition DOES NOT support coordinates. We must trap this here.
        if (action === 'click' && (args.x !== undefined || args.y !== undefined)) {
            console.log(`⚠️ STRICT MODE: Agent tried click(${args.x}, ${args.y}). Converting to MOVE.`);

            // A. Execute MOVE instead
            await tools.move({ x: args.x, y: args.y });

            // B. Optional: Crosshair Verify (Good practice, keep it)
            try {
                try { await tools.key({ key: 'escape' }); } catch (e) { console.debug('Escape key failed:', e.message); }
                await tools.key_combo({ keys: 'command+shift+4' });
                await tools.wait({ ms: 1000 });
                await tools.take_screenshot();
                await tools.key({ key: 'escape' });
            } catch (e) {
                console.error('⚠️ Verification error (continuing):', e.message);
            }

            // Record intent but mark as converted
            actionHistory.push({ action: 'click', args: { x: args.x, y: args.y }, result: 'syntax_correction_move' });

            return {
                success: true,
                message: `⚠️ SYNTAX WARNING: 'click' DOES NOT accept coordinates.\nI have executed 'move(${args.x}, ${args.y})' for you.\n\n❌ WRONG: {"action": "click", "args": {"x": ${args.x}, "y": ${args.y}}}
✅ CORRECT:\nStep 1: {"action": "move", "args": {"x": ${args.x}, "y": ${args.y}}}
Step 2: {"action": "click", "args": {}}

PLEASE NOW SEND STEP 2 (Click with NO ARGS).`
            };
        }

        // CASE 2: VALID USAGE -> `click()` (No Args)
        if (action === 'click' && (args.x === undefined && args.y === undefined)) {
            console.log("✅ Strict Mode: Valid 'click' (no args) received.");
            const result = await tools.click();
            await tools.take_screenshot();
            actionHistory.push({ action: 'click', args: {}, result: 'clicked' });
            return { success: true, message: "✅ CLICKED." };
        }

        // Update Global State
        lastActionType = action;
        lastActionArgs = args;
        actionHistory.push({ action, args, timestamp: Date.now() });

        // Keep history manageable
        if (actionHistory.length > CONFIG.ACTION_HISTORY_LIMIT) actionHistory.shift();

        // Handle action name variations
        if (action === 'key_press' || action === 'press_key') {
            if (args.key === 'enter') {
                action = 'enter';
                args = {};
            } else if (args.key === 'tab') {
                action = 'tab';
                args = {};
            } else if (args.key === 'escape') {
                action = 'escape';
                args = {};
            } else if (args.key === 'space') {
                action = 'space';
                args = {};
            } else if (args.key === 'backspace') {
                action = 'backspace';
                args = {};
            } else {
                action = 'key';
                args = { key: args.key };
            }
        }

        // 0.6 SCROLL TOOL HIJACK (Force Page Keys - NO INVERSION)
        // User Request: "force ai to use scroll only when key combo pagedown or pageup doesnot work"
        // Fix: "dont apply the inverse logic in this"
        if (action === 'scroll') {
            console.log("🛑 GUARD RAIL: Hijacking 'scroll' tool -> Redirecting to Page Keys (Standard Logic)");

            let keyToPress = 'pagedown'; // Default to down

            // Check args to determine direction
            if (args.direction === 'up' || (args.amount && args.amount < 0)) {
                keyToPress = 'pageup';
            }

            // DIRECT EXECUTION (Bypassing downstream logic to avoid double-inversion)
            if (tools.key) {
                const result = await tools.key({ key: keyToPress });
                console.log(`✅ Hijack Result: Pressed ${keyToPress} instead of scrolling`);

                // Record context manually since we return early
                lastActionType = 'key';
                lastActionArgs = { key: keyToPress };
                actionHistory.push({ action: 'key', args: { key: keyToPress }, timestamp: Date.now() });

                // Screenshot update
                await tools.take_screenshot();
                return result;
            }
        }

        // 🔄 INVERSE SCROLLING LOGIC (Natural Scrolling)
        // User Request: "scroll the opposite if the ai says down then do up and visa versa"
        if (action === 'key') {
            if (args.key === 'pagedown' || args.key === 'down') {
                console.log("🔄 SCROLL INVERSION: 'Down' command -> Pressing 'PageUp' (Natural Scroll)");
                args.key = 'pageup';
            } else if (args.key === 'pageup' || args.key === 'up') {
                console.log("🔄 SCROLL INVERSION: 'Up' command -> Pressing 'PageDown' (Natural Scroll)");
                args.key = 'pagedown';
            }
        }

        console.log(`🦾 Executing: ${action}(${JSON.stringify(args)})`);
        if (tools[action]) {
            // [NEW] Granular Status Logging
            console.log(`STATUS: Executing ${action} ${JSON.stringify(args)}`);

            // [SPOTLIGHT AUTO-SPACE] Check if opening Spotlight BEFORE execution
            if (action === 'key_combo') {
                const keyCombination = (args.keys || "").toLowerCase();
                if (isSpotlightTrigger(keyCombination)) {
                    console.log("🎯 Detected Spotlight trigger - will press space after opening");
                }
            }

            const result = await tools[action](args);
            console.log("✅ Tool result:", result);

            // [NEW] Fixed Automatic Space after Spotlight
            // User requested: "make it also work ... showing small grey text"


            // Auto Update Status for Verification
            if (action === 'type') {
                console.log(`STATUS: Typing " ${args.text}"...`);
            }
            if (action === 'click') {
                console.log("STATUS: Clicking...");
            }

            // Take screenshot after action (except for wait and screenshot)
            if (action !== 'wait' && action !== 'take_screenshot') {
                console.log("STATUS: Verifying screen state...");
                await tools.take_screenshot();
            }

            if (action === 'key_combo') {
                const keyCombination = (args.keys || "").toLowerCase();
                // Check if it's opening spotlight (cmd+space variants)
                if (isSpotlightTrigger(keyCombination)) {
                    console.log("🔔 Spotlight opened via key_combo - executing auto-space sequence...");
                    await handleSpotlightOpening();
                }
            }

            return true;
        } else if (action === 'stop') {
            return { stop: true };
        } else if (action === 'ask_user') {
            console.log(`🗣️ Asking user: ${args.question}`);
            if (tools.notify) await tools.notify({ title: "AI Agent Needs Input", message: args.question });
            return { stop: true, ask_user: true, question: args.question };
        } else {
            console.log("❌ Unknown action:", action);
            return false;
        }

    } catch (error) {
        console.error("❌ Execution error:", error.message);
        return false;
    }


}

// 🔧 Helper function to extract JSON from text
function extractJSON(text) {
    // Strategy 1: Code block
    const codeMatch = text.match(/```(?:json)?\s*([\s\S]*?)\s*```/);
    if (codeMatch) {
        try {
            return JSON.parse(codeMatch[1]);
        } catch (e) {
            // ignore
        }
    }

    // Strategy 2: Find first { and try to parse
    const firstBrace = text.indexOf('{');
    if (firstBrace !== -1) {
        let currentText = text.substring(firstBrace);
        // Try to verify if it's a valid JSON by counting braces or just try parsing
        // Simple approach: stack counter
        let stack = 0;
        let endIndex = -1;
        let inString = false;
        let escape = false;

        for (let i = 0; i < currentText.length; i++) {
            const char = currentText[i];

            if (escape) {
                escape = false;
                continue;
            }

            if (char === '\\') {
                escape = true;
                continue;
            }

            if (char === '"' && !escape) {
                inString = !inString;
                continue;
            }

            if (!inString) {
                if (char === '{') {
                    stack++;
                } else if (char === '}') {
                    stack--;
                    if (stack === 0) {
                        endIndex = i;
                        break;
                    }
                }
            }
        }

        if (endIndex !== -1) {
            const jsonStr = currentText.substring(0, endIndex + 1);
            try {
                const parsed = JSON.parse(jsonStr);
                if (parsed.action) return parsed;
            } catch (e) {
                // ignore
            }
        }
    }

    return null;
}

// 🔁 MAIN AGENT FUNCTION

// 🚔 SPOTLIGHT VALIDATOR FUNCTION
async function spotlightValidator(previousAction, proposedAction, actionHistory) {
    try {
        // Check if previous action was Spotlight opening
        const wasSpotlightOpened = previousAction && 
            previousAction.action === 'key_combo' && 
            previousAction.args && previousAction.args.keys &&
            previousAction.args.keys.includes('LeftCmd') && 
            previousAction.args.keys.includes('Space');

        // Check if Space was just pressed
        const wasSpacePressed = previousAction && 
            previousAction.action === 'key' && 
            previousAction.args && previousAction.args.key === 'space';

        // Only validate if Spotlight related
        if (!wasSpotlightOpened && !wasSpacePressed) {
            return { status: "APPROVED" };
        }

        console.log("🚔 SPOTLIGHT VALIDATOR checking sequence...");
        console.log(`   Previous: ${previousAction?.action} | Proposed: ${proposedAction?.action}`);

        // Check the violation
        if (wasSpotlightOpened && proposedAction?.action === 'type') {
            console.log("🚨 VIOLATION: Type without Space!");
            return {
                status: "REJECTED",
                reason: "SPOTLIGHT LAW BROKEN! You opened Spotlight but did NOT press Space. You must press Space BEFORE typing. Sequence: Spotlight → Space → Type"
            };
        }

        if (wasSpacePressed && proposedAction?.action === 'key_combo') {
            console.log("🚨 VIOLATION: Key combo after Space instead of Type!");
            return {
                status: "REJECTED",
                reason: "After pressing Space, you must Type or press Enter next. Do not use other key combinations."
            };
        }

        console.log("✅ Sequence valid");
        return { status: "APPROVED" };

    } catch (error) {
        console.error("Validator error:", error.message);
        return { status: "APPROVED" };
    }
}


async function runAgent(userGoal, context = "") {
    // 📸 ALWAYS take a fresh screenshot first to ensure state is current
    // This fixes the ENOENT error when running from Electron (which doesn't pre-capture)
    await tools.take_screenshot();

    const imageBase64 = fs.readFileSync(path.join(os.tmpdir(), "agent_screen.png"), "base64");
    const screenSize = await tools.get_screen_size();

    // Step 1: Plan the action
    const actionPlan = await planNextAction(userGoal, imageBase64, context, screenSize);

    // Step 2: Execute the action directly
    const result = await executeActionDirect(actionPlan);

    // Check for stop signal
    if (result && result.stop) {
        return { success: true, actionPlan, stop: true };
    }

    return { success: result, actionPlan };
}

export default runAgent;